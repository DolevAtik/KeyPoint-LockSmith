---
import { Image } from 'astro:assets';
import { gallery } from '../data/gallery';

/**
 * Before / after work gallery.
 *
 * Each job is an interactive comparison: drag (or use the range input) to wipe
 * between the before and after photos. Cards are intentional here — they wrap
 * the slider interaction, not decorative chrome.
 *
 * The section is only mounted when gallery has at least one pair.
 */
if (gallery.length === 0) {
  // Nothing to render — parent should also gate on length, but stay safe.
}
---

{
  gallery.length > 0 && (
    <section id="work" class="section-y bg-paper text-on-paper" aria-labelledby="work-heading">
      <div class="container-page">
        <div class="mx-auto max-w-2xl text-center">
          <p class="eyebrow reveal text-gold-deep">Our work</p>
          <h2
            id="work-heading"
            class="reveal mt-3 text-[1.75rem] sm:mt-4 sm:text-4xl lg:text-[2.75rem]"
          >
            Before &amp; after
          </h2>
          <p class="reveal mt-3 text-[1.0625rem] text-on-paper-muted sm:mt-5">
            Real jobs from the field — drag the handle to compare.
          </p>
        </div>

        <ul class="mt-8 grid gap-6 sm:mt-12 sm:gap-8 lg:mt-14 lg:grid-cols-2">
          {gallery.map((job, i) => (
            <li class="reveal" style={`--reveal-delay: ${Math.min(i, 3) * 80}ms`}>
              <figure class="overflow-hidden rounded-2xl border border-paper-line bg-paper-card shadow-card">
                <div
                  class="ba group relative aspect-[3/4] touch-none select-none overflow-hidden bg-ink sm:aspect-[4/5]"
                  data-ba
                >
                  <Image
                    src={job.after}
                    alt={job.afterAlt ?? `After: ${job.caption}`}
                    widths={[480, 720, 960]}
                    sizes="(max-width: 1024px) 100vw, 50vw"
                    class="absolute inset-0 h-full w-full object-cover"
                    loading="lazy"
                  />

                  <div class="ba-before absolute inset-0 overflow-hidden" data-ba-before style="width: 50%">
                    <Image
                      src={job.before}
                      alt={job.beforeAlt ?? `Before: ${job.caption}`}
                      widths={[480, 720, 960]}
                      sizes="(max-width: 1024px) 100vw, 50vw"
                      class="ba-before-img absolute inset-0 h-full max-w-none object-cover"
                      loading="lazy"
                    />
                  </div>

                  <div
                    class="pointer-events-none absolute top-3 left-3 rounded-md bg-ink/75 px-2.5 py-1 font-display text-[0.7rem] font-bold tracking-[0.14em] text-on-ink uppercase backdrop-blur-sm"
                  >
                    Before
                  </div>
                  <div
                    class="pointer-events-none absolute top-3 right-3 rounded-md bg-gold/90 px-2.5 py-1 font-display text-[0.7rem] font-bold tracking-[0.14em] text-on-gold uppercase"
                  >
                    After
                  </div>

                  <div
                    class="ba-handle pointer-events-none absolute inset-y-0 z-10 flex w-11 -translate-x-1/2 items-center justify-center"
                    data-ba-handle
                    style="left: 50%"
                    aria-hidden="true"
                  >
                    <span class="absolute inset-y-0 left-1/2 w-0.5 -translate-x-1/2 bg-gold shadow-[0_0_0_1px_rgb(11_13_16_/_0.35)]" />
                    <span class="relative grid h-11 w-11 place-items-center rounded-full border-2 border-gold bg-ink text-gold shadow-lift">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path
                          d="M8 12H3m0 0 3-3M3 12l3 3M16 12h5m0 0-3-3m3 3-3 3"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>
                  </div>

                  <label class="sr-only" for={`ba-range-${job.id}`}>
                    Compare before and after for {job.caption}
                  </label>
                  <input
                    id={`ba-range-${job.id}`}
                    class="ba-range absolute inset-0 z-20 m-0 h-full w-full cursor-ew-resize appearance-none bg-transparent opacity-0"
                    type="range"
                    min="0"
                    max="100"
                    value="50"
                    data-ba-range
                  />
                </div>

                <figcaption class="border-t border-paper-line px-4 py-3.5 text-center font-display text-[0.95rem] font-semibold text-on-paper sm:px-5 sm:py-4 sm:text-[1.05rem]">
                  {job.caption}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  /* Keep the "before" image locked to the full frame width so the wipe does
     not squash it as the clip narrows. */
  .ba-before-img {
    width: 100%;
    min-width: 100%;
  }

  /* The visible clip width is driven as a % of the comparison frame; the nested
     image must stay as wide as that full frame. */
  .ba[data-ba] .ba-before-img {
    width: var(--ba-frame-w, 100%);
    min-width: var(--ba-frame-w, 100%);
  }

  .ba-range::-webkit-slider-thumb {
    appearance: none;
    width: 44px;
    height: 100%;
    cursor: ew-resize;
  }

  .ba-range::-moz-range-thumb {
    width: 44px;
    height: 100%;
    border: 0;
    background: transparent;
    cursor: ew-resize;
  }
</style>

<script>
  function syncFrameWidth(root: HTMLElement) {
    root.style.setProperty('--ba-frame-w', `${root.clientWidth}px`);
  }

  function setPosition(root: HTMLElement, percent: number) {
    const clamped = Math.min(100, Math.max(0, percent));
    const before = root.querySelector<HTMLElement>('[data-ba-before]');
    const handle = root.querySelector<HTMLElement>('[data-ba-handle]');
    const range = root.querySelector<HTMLInputElement>('[data-ba-range]');
    if (!before || !handle || !range) return;

    before.style.width = `${clamped}%`;
    handle.style.left = `${clamped}%`;
    if (Number(range.value) !== clamped) range.value = String(clamped);
  }

  function bind(root: HTMLElement) {
    const range = root.querySelector<HTMLInputElement>('[data-ba-range]');
    if (!range) return;

    syncFrameWidth(root);
    setPosition(root, Number(range.value) || 50);

    range.addEventListener('input', () => setPosition(root, Number(range.value)));

    const ro = new ResizeObserver(() => {
      syncFrameWidth(root);
      setPosition(root, Number(range.value));
    });
    ro.observe(root);
  }

  function init() {
    document.querySelectorAll<HTMLElement>('[data-ba]').forEach(bind);
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
