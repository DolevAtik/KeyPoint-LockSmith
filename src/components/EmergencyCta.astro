---
import Icon from './Icon.astro';
import { site, telHref, whatsappHref, addressDisplay, WA_EMERGENCY_MESSAGE } from '../data/site';

const wa = whatsappHref(WA_EMERGENCY_MESSAGE);
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(addressDisplay)}`;
---

<section
  id="contact"
  class="relative overflow-hidden bg-[linear-gradient(135deg,#f0cd82_0%,#d4a24c_45%,#a9761f_100%)]"
  aria-labelledby="contact-heading"
>
  <!-- Texture + oversized keyhole watermark -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute inset-0 opacity-[0.16]"
      style="background-image: linear-gradient(rgba(0,0,0,.5) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,.5) 1px, transparent 1px); background-size: 46px 46px;"
    >
    </div>
    <svg
      class="absolute -top-16 -right-10 h-[26rem] w-[26rem] text-on-gold/[0.07] sm:-right-4"
      viewBox="0 0 100 100"
      fill="currentColor"
    >
      <circle cx="50" cy="38" r="17" />
      <path d="M42 52h16l6 36H36z" />
    </svg>
  </div>

  <div class="container-page relative py-12 sm:py-18 lg:py-24">
    <div class="mx-auto max-w-3xl text-center">
      <p
        class="eyebrow reveal inline-flex items-center gap-2 rounded-full border border-on-gold/25 bg-on-gold/10 px-4 py-2 text-on-gold"
      >
        <Icon name="alert" size={15} />
        Need help now?
      </p>

      <h2
        id="contact-heading"
        class="reveal mt-4 text-[1.95rem] leading-[1.06] text-on-gold sm:mt-6 sm:text-5xl lg:text-[3.4rem]"
        style="--reveal-delay: 60ms"
      >
        Locked Out? Call KeyPoint.
      </h2>

      <p
        class="reveal mx-auto mt-3 max-w-xl text-[1.0625rem] font-medium text-on-gold/80 sm:mt-5 sm:text-lg"
        style="--reveal-delay: 120ms"
      >
        One call to {site.name} — {site.owner.split(' ')[0]} gives you a straight answer on what he
        can do and when he can be there.
      </p>

      <!-- Oversized targets: this block is built for a one-handed tap on a phone -->
      <div
        class="reveal mx-auto mt-6 flex max-w-lg flex-col gap-3 sm:mt-9 sm:max-w-none sm:flex-row sm:justify-center"
        style="--reveal-delay: 180ms"
      >
        <a
          href={telHref}
          class="btn btn-lg group w-full !min-h-[3.75rem] !px-3 bg-ink !text-[0.98rem] text-gold-bright shadow-[0_16px_40px_-14px_rgba(0,0,0,0.65)] hover:bg-[#15191f] sm:w-auto sm:!min-h-[4rem] sm:!px-8 sm:!text-[1.15rem]"
          data-cta="contact-call"
        >
          <Icon name="phone" size={22} class="transition-transform duration-300 group-hover:-rotate-12" />
          <span class="tracking-tight">Call Now</span>
        </a>

        <a
          href={wa}
          target="_blank"
          rel="noopener"
          class="btn btn-lg w-full !min-h-[3.75rem] border-on-gold/25 bg-on-gold/[0.1] !text-[1.05rem] text-on-gold hover:bg-on-gold/15 sm:w-auto sm:!min-h-[4rem]"
          data-cta="contact-whatsapp"
        >
          <Icon name="whatsapp" size={22} />
          WhatsApp Us
        </a>
      </div>

      <a
        href={mapsHref}
        target="_blank"
        rel="noopener"
        class="reveal mt-6 inline-flex items-center gap-1.5 text-[0.9rem] font-medium text-on-gold/80 underline-offset-2 hover:text-on-gold hover:underline sm:mt-8"
        style="--reveal-delay: 220ms"
      >
        <Icon name="map-pin" size={15} />
        {addressDisplay}
      </a>
    </div>
  </div>
</section>
