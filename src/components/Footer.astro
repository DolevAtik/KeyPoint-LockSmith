---
import { Image } from 'astro:assets';
import logoLight from '../assets/logo-light.png';
import Icon from './Icon.astro';
import { site, telHref, mailHref, whatsappHref, addressDisplay, WA_DEFAULT_MESSAGE } from '../data/site';

const wa = whatsappHref(WA_DEFAULT_MESSAGE);
const year = new Date().getFullYear();

---

<footer class="kp-footer border-t border-ink-line bg-ink text-on-ink">
  <div
    class="container-page flex flex-col gap-4 py-6 pb-[calc(1.5rem+4.75rem)] md:flex-row md:items-center md:justify-between lg:pb-6"
  >
    <div class="flex items-center justify-between gap-4">
      <a
        href="#home"
        class="inline-flex min-h-11 shrink-0 items-center rounded-lg"
        aria-label={`${site.name} — back to top`}
      >
        <Image
          src={logoLight}
          alt="KeyPoint Locksmith logo"
          width={185}
          height={101}
          loading="lazy"
          class="h-8 w-auto"
        />
      </a>

      <div class="flex gap-2 lg:hidden">
        <a
          href={wa}
          target="_blank"
          rel="noopener"
          class="grid h-11 w-11 place-items-center rounded-xl border border-white/12 text-whatsapp"
          aria-label="Message us on WhatsApp"
          data-cta="footer-whatsapp"
        >
          <Icon name="whatsapp" size={18} />
        </a>
        <a
          href={mailHref}
          class="grid h-11 w-11 place-items-center rounded-xl border border-white/12 text-gold"
          aria-label={`Email ${site.email}`}
        >
          <Icon name="mail" size={18} />
        </a>
      </div>
    </div>

    <div class="flex flex-col gap-2 border-t border-ink-line pt-4 lg:flex-row lg:items-center lg:gap-5 lg:border-0 lg:pt-0">
      <a
        href={telHref}
        class="inline-flex min-h-11 items-center font-display font-bold tracking-tight text-gold transition-colors hover:text-gold-bright"
        data-cta="footer-call"
      >
        {site.phoneDisplay}
      </a>
      <p class="text-[0.8rem] text-on-ink-muted">{addressDisplay}</p>
      <p class="text-[0.8rem] text-on-ink-muted">&copy; {year} {site.name}. All rights reserved.</p>

      <div class="hidden gap-2 lg:flex">
        <a
          href={wa}
          target="_blank"
          rel="noopener"
          class="grid h-11 w-11 place-items-center rounded-xl border border-white/12 text-whatsapp"
          aria-label="Message us on WhatsApp"
          data-cta="footer-whatsapp"
        >
          <Icon name="whatsapp" size={18} />
        </a>
        <a
          href={mailHref}
          class="grid h-11 w-11 place-items-center rounded-xl border border-white/12 text-gold"
          aria-label={`Email ${site.email}`}
        >
          <Icon name="mail" size={18} />
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  @media (orientation: landscape) and (max-height: 32rem) and (max-width: 63.99rem) {
    .kp-footer > div {
      padding-bottom: 1.5rem;
    }
  }
</style>
