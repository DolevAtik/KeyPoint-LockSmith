---
import { Image } from 'astro:assets';
import logoLight from '../assets/logo-light.png';
import Icon from './Icon.astro';
import { site, telHref, whatsappHref, navLinks, WA_DEFAULT_MESSAGE } from '../data/site';
import { gallery } from '../data/gallery';

const wa = whatsappHref(WA_DEFAULT_MESSAGE);

/** Insert Work after Services once the gallery has real photos. */
const links =
  gallery.length > 0
    ? [
        ...navLinks.slice(0, 2),
        { label: 'Work', href: '#work' },
        ...navLinks.slice(2),
      ]
    : [...navLinks];

const mobileCols = links.length <= 4 ? 'grid-cols-4' : 'grid-cols-5';
---

{/* Watched by the script below to decide when the header turns solid. */}
<div id="kp-top-sentinel" aria-hidden="true"></div>

<header id="kp-header" class="sticky top-0 z-50 transition-[background-color,box-shadow,border-color] duration-300">
  <div class="border-b border-transparent bg-transparent transition-colors duration-300" data-header-surface>
    <nav class="kp-primary-nav container-page flex h-[68px] items-center justify-between gap-4 lg:h-[80px]" aria-label="Main">
      <a
        href="#home"
        class="inline-flex min-h-11 shrink-0 items-center rounded-lg"
        aria-label={`${site.name} — back to top`}
      >
        <Image
          src={logoLight}
          alt="KeyPoint Locksmith logo"
          width={172}
          height={92}
          loading="eager"
          class="h-9 w-auto sm:h-10 lg:h-11"
        />
      </a>

      <!-- Desktop links -->
      <ul class="hidden items-center gap-1 lg:flex">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                data-nav-link={link.href}
                class="desktop-nav-link relative rounded-lg px-3.5 py-2 font-display text-[0.95rem] font-semibold text-on-ink/85 transition-colors duration-200 hover:text-gold focus-visible:text-gold"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Desktop actions -->
      <div class="hidden items-center gap-2.5 lg:flex">
        <a
          href={wa}
          target="_blank"
          rel="noopener"
          class="btn btn-ghost-dark !min-h-[46px] !px-3.5"
          aria-label="Message KeyPoint Locksmith on WhatsApp"
          title="WhatsApp"
        >
          <Icon name="whatsapp" size={20} class="text-whatsapp" />
        </a>
        <a href={telHref} class="btn btn-gold !min-h-[46px] !px-5" data-cta="nav-call">
          <Icon name="phone" size={18} />
          <span class="flex flex-col items-start leading-none">
            <span class="text-[0.6rem] font-bold tracking-[0.18em] uppercase opacity-75">Call Now</span>
            <span class="mt-0.5 text-[0.95rem] tracking-tight">{site.phoneDisplay}</span>
          </span>
        </a>
      </div>

      <!-- Mobile action: navigation links sit in the row directly below. -->
      <div class="flex items-center lg:hidden">
        <a
          href={telHref}
          class="btn btn-gold !min-h-[44px] !gap-2 !px-4 !text-[0.9rem]"
          data-cta="nav-call-mobile"
        >
          <Icon name="phone" size={17} />
          <span>Call</span>
        </a>
      </div>
    </nav>

    <nav class:list={['kp-link-row container-page grid border-t border-white/8 lg:hidden', mobileCols]} aria-label="Mobile">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'mobile-nav-link relative flex min-h-11 items-center justify-center font-display font-semibold text-on-ink-muted transition-colors duration-200 after:absolute after:bottom-0 after:h-0.5 after:scale-x-0 after:rounded-full after:bg-gold after:transition-transform hover:text-gold hover:after:scale-x-100 focus-visible:text-gold',
              links.length > 4
                ? 'px-0.5 text-[0.72rem] after:inset-x-2 sm:text-[0.78rem]'
                : 'px-1 text-[0.78rem] after:inset-x-3',
            ]}
            data-nav-link={link.href}
          >
            {link.label === 'Service Areas' ? 'Areas' : link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  #kp-top-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    height: 1px;
    width: 1px;
    pointer-events: none;
  }

  /* Solid, legible header once the hero has scrolled away. */
  #kp-header.is-stuck [data-header-surface] {
    background-color: color-mix(in srgb, var(--color-ink) 88%, transparent);
    border-bottom-color: var(--color-ink-line);
    box-shadow: 0 10px 30px -18px rgb(0 0 0 / 0.9);
    backdrop-filter: blur(14px) saturate(140%);
  }

  .mobile-nav-link.is-active {
    color: var(--color-gold);
  }

  .mobile-nav-link.is-active::after {
    transform: scaleX(1);
  }

  .desktop-nav-link.is-active {
    color: var(--color-gold);
  }

  @media (orientation: landscape) and (max-height: 32rem) and (max-width: 63.99rem) {
    .kp-primary-nav {
      height: 3.5rem;
    }

    .kp-link-row .mobile-nav-link {
      min-height: 2.75rem;
    }
  }

</style>

<script>
  // --- Header state -------------------------------------------------------
  const header = document.getElementById('kp-header');
  const sentinel = document.getElementById('kp-top-sentinel');

  if (header && sentinel && 'IntersectionObserver' in window) {
    // Observing a 1px sentinel avoids running a handler on every scroll frame.
    new IntersectionObserver(
      ([entry]) => header.classList.toggle('is-stuck', !entry.isIntersecting),
      { threshold: 0 }
    ).observe(sentinel);
  }

  const navLinksEls = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-link]'));
  const navSections = Array.from(
    new Set(navLinksEls.map((link) => link.dataset.navLink ?? '').filter((href) => href.startsWith('#')))
  )
    .map((href) => document.querySelector<HTMLElement>(href))
    .filter((section): section is HTMLElement => Boolean(section));

  if (navLinksEls.length && navSections.length && 'IntersectionObserver' in window) {
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        const current = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!current) return;

        const id = `#${current.target.id}`;
        navLinksEls.forEach((link) => {
          link.classList.toggle('is-active', link.dataset.navLink === id);
        });
      },
      { rootMargin: '-25% 0px -60% 0px', threshold: [0, 0.2] }
    );

    navSections.forEach((section) => sectionObserver.observe(section));
  }

</script>
