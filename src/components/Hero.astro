---
import { Image } from 'astro:assets';
import logo from '../assets/logo-light.png';
import Icon from './Icon.astro';
import { telHref, whatsappHref, WA_EMERGENCY_MESSAGE } from '../data/site';
import { reviews } from '../data/reviews';

const wa = whatsappHref(WA_EMERGENCY_MESSAGE);

const pillars = [
  { icon: 'home', label: 'Residential' },
  { icon: 'building', label: 'Commercial' },
  { icon: 'car', label: 'Automotive' },
];

/** Compact quotes for the hero rotator — the `short` copy fits 2–3 lines unabridged. */
const heroReviews = reviews.slice(0, 4).map((r) => ({
  name: r.name,
  rating: r.rating,
  location: r.location,
  review: r.short ?? r.review,
}));
---

<section
  id="home"
  class="kp-hero relative flex flex-col overflow-hidden bg-ink"
>
  <!-- Ambient light via radial gradients only — CSS filter:blur on large orbs
       has crashed Safari's content process on iPhones under memory pressure. -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="grid-texture absolute inset-0 opacity-70"></div>
    <div
      class="absolute -top-40 -right-32 h-[38rem] w-[38rem] opacity-[0.55]"
      style="background: radial-gradient(circle, rgb(212 162 76 / 0.55) 0%, transparent 68%)"
    >
    </div>
    <div
      class="absolute -bottom-56 -left-40 h-[34rem] w-[34rem] opacity-40"
      style="background: radial-gradient(circle, rgb(30 58 95 / 0.55) 0%, transparent 70%)"
    >
    </div>
    <!-- Soft fade at the bottom edge. -->
    <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-b from-transparent to-ink"></div>
  </div>

  <div class="kp-hero-inner container-page relative flex flex-1 flex-col pt-2 pb-4 sm:pt-14 sm:pb-16 lg:justify-center lg:pt-20 lg:pb-24">
    <div class="kp-hero-grid grid flex-1 items-stretch lg:items-center lg:gap-8 xl:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] xl:gap-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)]">
      <!-- ------------------------------------------------------------ -->
      <!-- Copy + conversion                                             -->
      <!-- ------------------------------------------------------------ -->
      <div class="kp-hero-copy mx-auto flex w-full max-w-2xl flex-1 flex-col justify-center gap-5 text-center font-hero sm:block sm:flex-none sm:text-left lg:mx-0">
        <div class="kp-hero-brand flex flex-col items-center gap-5 sm:items-start sm:gap-0">
          <h1 class="kp-hero-logo-row reveal flex justify-center sm:justify-start" style="--reveal-delay: 60ms">
            <Image
              src={logo}
              alt="KeyPoint Locksmith"
              width={585}
              height={320}
              loading="eager"
              fetchpriority="high"
              class="kp-hero-logo h-auto w-[min(100%,26rem)] lg:w-[min(100%,28rem)] xl:w-[min(100%,32rem)]"
            />
          </h1>

          <p
            class="kp-hero-copy-text reveal max-w-xl font-semibold tracking-[-0.025em] text-on-ink-muted sm:mt-6 sm:max-w-none sm:text-xl sm:leading-relaxed sm:font-medium sm:tracking-[-0.015em]"
            style="--reveal-delay: 120ms"
          >
            <span class="kp-hero-line">Locked out or lost your keys?</span>
            <span class="kp-hero-line">Emergency locksmith help across</span>
            <span class="kp-hero-line">Ventura County &amp; Los Angeles.</span>
          </p>
        </div>

        <div
          id="kp-hero-reviews"
          class="reveal flex w-full max-w-md flex-none flex-col sm:mt-8 sm:max-w-lg lg:mx-0"
          style="--reveal-delay: 150ms"
          aria-roledescription="carousel"
          aria-label="Customer reviews"
        >
          <div class="relative flex flex-none flex-col overflow-hidden rounded-2xl border border-white/10 bg-white/[0.04] px-3.5 py-3 sm:px-5 sm:py-4">
            <div class="kp-hero-review-stage relative min-h-[6.75rem]">
              {
                heroReviews.map((review, i) => (
                  <figure
                    class:list={[
                      'kp-hero-review absolute inset-0 flex flex-col items-center justify-center text-center sm:inset-x-0 sm:top-0 sm:bottom-auto sm:items-start sm:justify-start sm:text-left',
                      i === 0 ? 'is-active' : '',
                    ]}
                    data-hero-review={i}
                    aria-hidden={i === 0 ? 'false' : 'true'}
                  >
                    <div
                      class="flex items-center gap-0.5 text-gold"
                      role="img"
                      aria-label={`Rated ${review.rating} out of 5`}
                    >
                      {Array.from({ length: 5 }).map((_, s) => (
                        <Icon
                          name="star"
                          size={14}
                          class={s < review.rating ? 'text-gold' : 'text-white/15'}
                        />
                      ))}
                    </div>
                    <blockquote class="mt-1.5 text-[0.83rem] leading-snug text-on-ink/90 sm:mt-2 sm:text-[0.95rem]">
                      “{review.review}”
                    </blockquote>
                    <figcaption class="mt-2 font-display text-[0.74rem] font-bold tracking-wide text-gold sm:mt-2.5 sm:text-[0.82rem]">
                      {review.name}
                      {review.location && (
                        <span class="font-sans font-medium text-on-ink-muted"> · {review.location}</span>
                      )}
                    </figcaption>
                  </figure>
                ))
              }
            </div>

            <div class="mt-2.5 flex items-center justify-center gap-1.5 sm:mt-3 sm:justify-start" role="tablist" aria-label="Review slides">
              {
                heroReviews.map((_, i) => (
                  <button
                    type="button"
                    class:list={['kp-hero-dot', i === 0 && 'is-active']}
                    data-hero-dot={i}
                    aria-label={`Show review ${i + 1}`}
                    aria-current={i === 0 ? 'true' : undefined}
                  />
                ))
              }
            </div>
          </div>
        </div>

        <div
          class="kp-hero-actions reveal flex flex-col gap-3 sm:mt-8 sm:flex-row sm:items-center sm:justify-start"
          style="--reveal-delay: 180ms"
        >
          <a
            href={telHref}
            class="btn btn-gold btn-lg w-full !min-h-14 !px-3 !text-[1.05rem] font-hero sm:w-auto sm:!min-h-12 sm:!px-8 sm:!text-base"
            data-cta="hero-call"
          >
            <Icon name="phone" size={22} />
            Call Now
          </a>
          <a
            href={wa}
            target="_blank"
            rel="noopener"
            class="btn btn-ghost-dark btn-lg w-full !min-h-14 !text-[1.05rem] font-hero sm:w-auto sm:!min-h-12 sm:!text-base"
            data-cta="hero-whatsapp"
          >
            <Icon name="whatsapp" size={22} class="text-whatsapp" />
            WhatsApp Us
          </a>
        </div>

        <!-- Service pillars -->
        <ul class="kp-hero-pillars reveal mt-6 hidden flex-wrap justify-center gap-2 sm:mt-9 sm:flex sm:gap-2.5 lg:justify-start" style="--reveal-delay: 220ms">
          {
            pillars.map((p) => (
              <li class="flex items-center gap-2 rounded-xl border border-white/10 bg-white/[0.04] px-3 py-2 sm:px-3.5 sm:py-2.5">
                <Icon name={p.icon} size={18} class="text-gold" />
                <span class="text-sm font-semibold tracking-[-0.01em] text-on-ink">{p.label}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- ------------------------------------------------------------ -->
      <!-- Hero artwork (decorative, desktop only to keep mobile light)  -->
      <!-- ------------------------------------------------------------ -->
      <div class="relative hidden lg:block" aria-hidden="true">
        <div class="kp-hero-art relative mx-auto aspect-square w-full max-w-[26rem]">
          <svg viewBox="0 0 400 400" class="h-full w-full" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="h-body" x1="120" y1="180" x2="280" y2="340" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#232a35" />
                <stop offset="1" stop-color="#0e1218" />
              </linearGradient>
              <linearGradient id="h-steel" x1="150" y1="90" x2="255" y2="190" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#e8edf4" />
                <stop offset="0.5" stop-color="#98a2b1" />
                <stop offset="1" stop-color="#5f6875" />
              </linearGradient>
              <linearGradient id="h-gold" x1="120" y1="180" x2="290" y2="330" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#f2d28a" />
                <stop offset="0.55" stop-color="#d4a24c" />
                <stop offset="1" stop-color="#9c6b19" />
              </linearGradient>
              <radialGradient id="h-glow">
                <stop offset="0" stop-color="#d4a24c" stop-opacity="0.42" />
                <stop offset="1" stop-color="#d4a24c" stop-opacity="0" />
              </radialGradient>
            </defs>

            <circle cx="200" cy="215" r="175" fill="url(#h-glow)" />

            <!-- Orbit rings -->
            <circle cx="200" cy="215" r="158" stroke="#d4a24c" stroke-opacity="0.14" stroke-width="1" />
            <circle
              class="hero-orbit"
              cx="200"
              cy="215"
              r="134"
              stroke="#d4a24c"
              stroke-opacity="0.3"
              stroke-width="1.5"
              stroke-dasharray="3 13"
              stroke-linecap="round"
            />

            <!-- Key, tucked behind the padlock -->
            <g transform="rotate(-38 200 215)" opacity="0.9">
              <path d="M196 208h118v14H196z" fill="url(#h-gold)" opacity="0.55" />
              <path d="M286 222h11v14h-11zM266 222h9v18h-9z" fill="url(#h-gold)" opacity="0.55" />
              <circle cx="176" cy="215" r="30" fill="url(#h-gold)" opacity="0.55" />
              <circle cx="176" cy="215" r="13" fill="#0b0d10" />
            </g>

            <!-- Padlock -->
            <path
              d="M163 196v-42a37 37 0 0 1 74 0v42"
              stroke="url(#h-steel)"
              stroke-width="17"
              stroke-linecap="round"
            />
            <rect x="126" y="192" width="148" height="136" rx="30" fill="url(#h-body)" />
            <rect
              x="126"
              y="192"
              width="148"
              height="136"
              rx="30"
              stroke="url(#h-gold)"
              stroke-width="2.5"
            />
            <rect x="139" y="205" width="122" height="110" rx="22" stroke="#ffffff" stroke-opacity="0.06" />

            <!-- Keyhole -->
            <g fill="url(#h-gold)">
              <circle cx="200" cy="248" r="16" />
              <path d="M192 260h16l6 34h-28z" />
            </g>
            <circle class="hero-pulse" cx="200" cy="252" r="46" fill="url(#h-glow)" />
          </svg>

          <!-- Floating labels -->
          <div
            class="hero-float absolute top-[16%] -left-2 flex items-center gap-2 rounded-xl border border-white/12 bg-ink-card/85 px-3.5 py-2.5 shadow-lift backdrop-blur-md"
          >
            <Icon name="bolt" size={17} class="text-gold" />
            <span class="font-display text-[0.82rem] font-bold text-on-ink">Emergency Lockouts</span>
          </div>

          <div
            class="hero-float hero-float--slow absolute top-[46%] -right-3 flex items-center gap-2 rounded-xl border border-white/12 bg-ink-card/85 px-3.5 py-2.5 shadow-lift backdrop-blur-md"
          >
            <Icon name="car-key" size={17} class="text-gold" />
            <span class="font-display text-[0.82rem] font-bold text-on-ink">Car Key Programming</span>
          </div>

          <div
            class="hero-float hero-float--slower absolute bottom-[10%] left-[8%] flex items-center gap-2 rounded-xl border border-white/12 bg-ink-card/85 px-3.5 py-2.5 shadow-lift backdrop-blur-md"
          >
            <Icon name="rekey" size={17} class="text-gold" />
            <span class="font-display text-[0.82rem] font-bold text-on-ink">Rekeying &amp; Repairs</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @media (width < 40rem) {
    .kp-hero-copy-text {
      /* Width-derived so the three nowrap lines never run off a narrow phone. */
      font-size: clamp(1rem, calc((100vw - 2.5rem) / 17.5), 1.5rem);
      line-height: 1.65;
    }

    .kp-hero-line {
      display: block;
      white-space: nowrap;
    }

    /* Real layout spacing rather than offsets, so a short viewport can never
       slide the copy under the review card. Shrinks with the screen. */
    .kp-hero-brand {
      gap: clamp(1.25rem, 6vh, 3.25rem);
    }
  }

  @media (width >= 40rem) {
    .kp-hero-line {
      display: inline;
    }

    .kp-hero-line + .kp-hero-line::before {
      content: ' ';
    }
  }

  /* Fill the first mobile screen (below the sticky nav) so the next section
     only appears after a deliberate scroll. */
  @media (width < 64rem) {
    .kp-hero {
      /* Mobile nav row is min-h-13 (3.25rem). Deliberately svh, not dvh: dvh
         re-measures while the URL bar collapses, resizing the hero mid-scroll
         and shunting the scroll position on every direction change. */
      min-height: calc(100svh - 3.25rem);
    }
  }

  /* Desktop: the hero has to land inside one screen below the 84px nav, so the
     logo and the rhythm between blocks scale off the viewport height instead of
     fixed rems. Untouched below 64rem. */
  @media (width >= 64rem) {
    .kp-hero {
      min-height: calc(100svh - 84px);
    }

    .kp-hero-inner {
      padding-block: clamp(0.75rem, 4vh, 3rem);
    }

    .kp-hero-logo-row {
      justify-content: flex-start;
    }

    /* As wide as the column allows, but never wider than the vertical budget
       left over by the copy, review card, buttons and pillars (logo_new is
       ~0.547 as tall as it is wide). */
    .kp-hero-logo {
      width: min(100%, clamp(10rem, calc(136vh - 640px), 40rem));
    }

    /* Break before "Emergency"; the last two lines stay on one line. */
    .kp-hero-line:nth-child(1) {
      display: block;
    }

    .kp-hero-line:nth-child(2)::before {
      content: none;
    }

    .kp-hero-copy-text {
      margin-top: clamp(0.75rem, 2.2vh, 1.5rem);
      font-size: clamp(1rem, 1.9vh, 1.25rem);
    }

    #kp-hero-reviews {
      margin-top: clamp(1rem, 3vh, 2rem);
    }

    .kp-hero-review-stage {
      min-height: clamp(5.5rem, 13vh, 6.75rem);
    }

    .kp-hero-actions {
      margin-top: clamp(1rem, 3vh, 2rem);
    }

    .kp-hero-pillars {
      margin-top: clamp(1rem, 3vh, 2.25rem);
    }

    .kp-hero-art {
      max-width: min(26rem, 42vh);
    }
  }

  @media (orientation: landscape) and (height <= 32rem) and (width < 64rem) {
    .kp-hero {
      min-height: auto;
    }

    .kp-hero-copy {
      justify-content: flex-start;
    }

    #kp-hero-reviews {
      display: none;
    }
  }

  .kp-hero-review {
    opacity: 0;
    transform: translateY(0.55rem);
    pointer-events: none;
    transition:
      opacity 0.45s var(--ease-out-soft, ease),
      transform 0.45s var(--ease-out-soft, ease);
  }

  .kp-hero-review.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .kp-hero-dot {
    height: 0.4rem;
    width: 0.4rem;
    border-radius: 999px;
    border: 0;
    padding: 0;
    background: rgb(255 255 255 / 0.22);
    cursor: pointer;
    transition:
      background-color 0.25s ease,
      width 0.25s ease;
  }

  .kp-hero-dot.is-active {
    width: 1.05rem;
    background: var(--color-gold);
  }

  @media (prefers-reduced-motion: reduce) {
    .kp-hero-review {
      transition: none;
      transform: none;
    }
  }

  .hero-orbit {
    transform-box: view-box;
    transform-origin: 200px 215px;
    animation: hero-spin 48s linear infinite;
  }

  .hero-pulse {
    transform-box: view-box;
    transform-origin: 200px 252px;
    animation: hero-breathe 5.5s ease-in-out infinite;
  }

  .hero-float {
    animation: hero-drift 7s ease-in-out infinite;
  }
  .hero-float--slow {
    animation-duration: 8.5s;
    animation-delay: -2s;
  }
  .hero-float--slower {
    animation-duration: 10s;
    animation-delay: -4s;
  }

  @keyframes hero-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes hero-breathe {
    0%,
    100% {
      opacity: 0.5;
      transform: scale(0.92);
    }
    50% {
      opacity: 1;
      transform: scale(1.08);
    }
  }

  @keyframes hero-drift {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-9px);
    }
  }
</style>

<script>
  // On desktop the entire hero sits above the fold, but the shared reveal
  // observer ignores the bottom 8% of the viewport, so the pillars would stay
  // hidden until the visitor scrolls. Reveal the hero's own blocks on load.
  if (window.matchMedia('(min-width: 64rem)').matches) {
    requestAnimationFrame(() => {
      document
        .querySelectorAll<HTMLElement>('.kp-hero .reveal')
        .forEach((el) => el.classList.add('is-in'));
    });
  }

  const root = document.getElementById('kp-hero-reviews');
  if (root) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-hero-review]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-hero-dot]'));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    const show = (next: number) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const on = i === index;
        slide.classList.toggle('is-active', on);
        slide.setAttribute('aria-hidden', on ? 'false' : 'true');
      });
      dots.forEach((dot, i) => {
        const on = i === index;
        dot.classList.toggle('is-active', on);
        if (on) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    };

    const start = () => {
      if (reduceMotion || slides.length < 2) return;
      stop();
      timer = setInterval(() => show(index + 1), 4500);
    };

    const stop = () => {
      if (timer) clearInterval(timer);
      timer = undefined;
    };

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        show(Number(dot.dataset.heroDot));
        start();
      });
    });

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);

    start();
  }
</script>
