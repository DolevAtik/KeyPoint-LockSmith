---
import Icon from './Icon.astro';

/**
 * Compact reassurance band sitting directly under the hero.
 *
 * Every claim here is a description of the service itself — no response times,
 * certifications, licences, ratings or years in business, none of which were
 * provided by the owner.
 */
const points = [
  { icon: 'shield-check', label: 'Professional Locksmith Service' },
  { icon: 'bolt', label: 'Fast Emergency Assistance' },
  { icon: 'map-pin', label: 'Local Service Areas' },
  { icon: 'phone', label: 'Easy to Reach' },
];
---

<section class="relative border-y border-ink-line bg-ink-raised" aria-label="Why customers call KeyPoint Locksmith">
  <div class="container-page">
    <ul class="grid grid-cols-2 divide-x divide-y divide-ink-line/70 lg:grid-cols-4 lg:divide-y-0">
      {
        points.map((p, i) => (
          <li
            class="reveal flex items-center gap-3 px-1 py-5 sm:gap-3.5 sm:px-4 lg:justify-center lg:px-3 lg:py-6"
            style={`--reveal-delay: ${i * 70}ms`}
          >
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl border border-gold/25 bg-gold/10 text-gold">
              <Icon name={p.icon} size={19} />
            </span>
            <span class="font-display text-[0.83rem] leading-tight font-bold text-on-ink sm:text-[0.95rem]">
              {p.label}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
