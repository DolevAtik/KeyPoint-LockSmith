---
import Icon from './Icon.astro';
import { areaCount } from '../data/areas';

const benefits = [
  {
    icon: 'bolt',
    title: 'Fast Response',
    body: 'Quick locksmith assistance when you need it most — call or send a WhatsApp message and get a straight answer about your situation.',
  },
  {
    icon: 'shield-check',
    title: 'Professional Service',
    body: 'Reliable, professional locksmith solutions using the right tools for the job, so your door, lock or vehicle is treated with care.',
  },
  {
    icon: 'key',
    title: 'Residential, Commercial & Automotive',
    body: 'Complete locksmith services for homes, businesses and vehicles — from a single stuck lock to a full master key system.',
  },
  {
    icon: 'map-pin',
    title: 'Serving Your Area',
    body: `Serving Ventura County and surrounding communities, with coverage across ${areaCount} cities in the San Fernando Valley and Los Angeles area.`,
  },
];
---

<section class="section-y bg-paper text-on-paper" aria-labelledby="benefits-heading">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow reveal text-gold-deep">Why call KeyPoint</p>
      <h2 id="benefits-heading" class="reveal mt-4 text-3xl sm:text-4xl lg:text-[2.75rem]">
        Locksmith help without the runaround
      </h2>
      <p class="reveal mt-5 text-[1.0625rem] text-on-paper-muted">
        You reach {`Lidor`} directly — no call centre, no dispatcher, no being passed between
        people while you stand outside your own front door.
      </p>
    </div>

    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
      {
        benefits.map((b, i) => (
          <li
            class="group reveal relative flex flex-col rounded-2xl border border-paper-line bg-paper-card p-6 shadow-card transition-[transform,box-shadow,border-color] duration-300 hover:-translate-y-1 hover:border-gold/45 hover:shadow-lift lg:p-7"
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-ink text-gold transition-transform duration-300 group-hover:scale-105">
              <Icon name={b.icon} size={24} />
            </span>
            <h3 class="mt-5 font-display text-lg leading-snug font-bold text-on-paper">{b.title}</h3>
            <p class="mt-2.5 text-[0.95rem] text-on-paper-muted">{b.body}</p>
            <span
              class="mt-5 h-1 w-10 rounded-full bg-gold/30 transition-all duration-300 group-hover:w-16 group-hover:bg-gold"
              aria-hidden="true"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>
