---
import Icon from './Icon.astro';
import { services } from '../data/services';
import { telHref } from '../data/site';

/** Most-requested work leads the top belt. */
const ordered = [...services.filter((s) => s.featured), ...services.filter((s) => !s.featured)];

/**
 * Two belts running in opposite directions. All twenty services stay on the
 * page without the section growing five rows tall, and splitting the list in
 * half keeps each loop short enough that a card comes round again quickly.
 * The mismatched durations stop the two rows from marching in lockstep.
 */
const half = Math.ceil(ordered.length / 2);
const rows = [
  { items: ordered.slice(0, half), direction: 'left', duration: '68s' },
  { items: ordered.slice(half), direction: 'right', duration: '82s' },
];
---

<section id="services" class="section-y relative overflow-hidden bg-ink" aria-labelledby="services-heading">
  <div class="grid-texture pointer-events-none absolute inset-0 opacity-50" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute top-0 left-1/2 h-64 w-[46rem] -translate-x-1/2 opacity-25"
    style="background: radial-gradient(circle, rgb(212 162 76 / 0.7) 0%, transparent 70%)"
    aria-hidden="true"
  >
  </div>

  <div class="container-page relative">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow reveal text-gold">What we do</p>
      <h2 id="services-heading" class="reveal mt-3 text-[1.75rem] text-on-ink sm:mt-4 sm:text-4xl lg:text-[2.75rem]">
        What KeyPoint handles
      </h2>
      <p class="reveal mt-3 text-[1.0625rem] text-on-ink-muted sm:mt-5">
        From a midnight lockout to a master key system — browse the work we handle most.
      </p>
    </div>
  </div>

  <!-- Full-bleed on purpose: the belts should run off both edges of the screen
       rather than stopping at the container. -->
  <div class="belt relative mt-7 sm:mt-10" data-belt>
    {
      rows.map((row) => (
        <div class="belt-row" data-direction={row.direction}>
          <ul class="belt-track flex w-max" style={`--belt-duration: ${row.duration}`}>
            {row.items.map((s) => (
              <li
                class:list={[
                  'service-card group mr-3 flex w-[15rem] shrink-0 flex-col items-center rounded-2xl border bg-gradient-to-b p-5 text-center transition-colors duration-300 sm:mr-3.5 sm:w-[17rem]',
                  s.featured
                    ? 'border-gold/25 from-[#1b202a] to-ink-raised hover:border-gold/55'
                    : 'border-white/8 from-ink-card to-ink-raised hover:border-gold/45',
                ]}
              >
                <span class="grid h-11 w-11 place-items-center rounded-xl border border-gold/20 bg-gold/10 text-gold transition-colors duration-300 group-hover:bg-gold group-hover:text-on-gold">
                  <Icon name={s.icon} size={21} />
                </span>

                <h3 class="mt-4 font-display text-[1.0625rem] leading-snug font-bold text-balance text-on-ink">
                  {s.name}
                </h3>
                <p class="mt-1.5 text-[0.875rem] leading-relaxed text-on-ink-muted">
                  {s.description}
                </p>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="container-page relative">
    <!-- WCAG 2.2.2: motion that starts on its own needs a way to stop it that
         does not depend on hovering. Revealed by the script, because without
         JS the belts do not run in the first place. -->
    <div id="belt-controls" class="mt-6 flex justify-center" hidden>
      <button
        type="button"
        id="belt-toggle"
        class="inline-flex min-h-11 items-center gap-2 rounded-full border border-white/12 bg-white/[0.04] px-4 py-2.5 font-display text-[0.85rem] font-semibold text-on-ink-muted transition-colors duration-200 hover:border-gold/45 hover:text-gold"
      >
        <span class="belt-icon-pause inline-flex"><Icon name="pause" size={13} /></span>
        <span class="belt-icon-play inline-flex"><Icon name="play" size={13} /></span>
        <span data-belt-label>Pause</span>
      </button>
    </div>

    <p class="reveal mt-5 text-center text-sm text-on-ink-muted sm:mt-6">
      Don't see your problem listed?<br />
      <a
        href={telHref}
        class="font-semibold text-gold underline decoration-gold/40 underline-offset-4 transition-colors hover:decoration-gold"
        data-cta="services-more"
      >
        Call and describe it
      </a> — chances are it's covered.
    </p>
  </div>
</section>

<style>
  /* Softens both ends so cards slide out of view instead of being chopped off
     at the edge of the screen. */
  .belt {
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 2rem,
      #000 calc(100% - 2rem),
      transparent 100%
    );
    mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 2rem,
      #000 calc(100% - 2rem),
      transparent 100%
    );
  }

  @media (width >= 48rem) {
    .belt {
      -webkit-mask-image: linear-gradient(
        90deg,
        transparent 0,
        #000 6rem,
        #000 calc(100% - 6rem),
        transparent 100%
      );
      mask-image: linear-gradient(
        90deg,
        transparent 0,
        #000 6rem,
        #000 calc(100% - 6rem),
        transparent 100%
      );
    }
  }

  .belt-row + .belt-row {
    margin-top: 0.75rem;
  }

  /* Before the script clones the track — and for anyone without JS — the rows
     are plain swipeable strips. Every service is reachable either way. */
  .belt-row {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x pan-y;
    scrollbar-width: none;
  }

  .belt-row::-webkit-scrollbar {
    display: none;
  }

  .belt[data-ready] .belt-row {
    overflow: hidden;
    touch-action: manipulation;
  }

  .belt[data-ready] .belt-track {
    animation: belt-left var(--belt-duration, 70s) linear infinite;
  }

  .belt[data-ready] [data-direction='right'] .belt-track {
    animation-name: belt-right;
  }

  /* Keep the service belts moving even when the OS asks for reduced motion —
     Pause is still available for anyone who wants to stop them. */
  @media (prefers-reduced-motion: reduce) {
    .belt[data-ready] .belt-track {
      animation: belt-left var(--belt-duration, 70s) linear infinite !important;
      animation-duration: var(--belt-duration, 70s) !important;
      animation-iteration-count: infinite !important;
    }

    .belt[data-ready] [data-direction='right'] .belt-track {
      animation-name: belt-right !important;
    }
  }

  /* Stops under the pointer, for a keyboard user tabbing in, or on demand. */
  .belt[data-ready] .belt-row:hover .belt-track,
  .belt[data-ready] .belt-row:focus-within .belt-track,
  #services[data-belt-paused] .belt[data-ready] .belt-track {
    animation-play-state: paused;
  }

  /* Each card carries its own right margin rather than the track carrying a
     gap, so the appended copy is exactly half the track and the seam lands
     invisibly. */
  @keyframes belt-left {
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes belt-right {
    from {
      transform: translateX(-50%);
    }
  }

  #services:not([data-belt-paused]) .belt-icon-play,
  #services[data-belt-paused] .belt-icon-pause {
    display: none;
  }
</style>

<script>
  const section = document.getElementById('services');
  const belt = section?.querySelector<HTMLElement>('[data-belt]');
  const controls = document.getElementById('belt-controls');
  const toggle = document.getElementById('belt-toggle');
  const label = toggle?.querySelector<HTMLElement>('[data-belt-label]');

  if (section && belt && controls && toggle && label) {
    // A second copy of each row is what makes the loop seamless: the track
    // travels exactly one copy's width and lands back where it started.
    for (const track of belt.querySelectorAll<HTMLElement>('.belt-track')) {
      for (const card of Array.from(track.children)) {
        const clone = card.cloneNode(true) as HTMLElement;
        clone.setAttribute('aria-hidden', 'true');
        track.appendChild(clone);
      }
    }

    belt.dataset.ready = '';
    controls.hidden = false;

    toggle.addEventListener('click', () => {
      const paused = section.toggleAttribute('data-belt-paused');
      label.textContent = paused ? 'Play' : 'Pause';
    });
  }
</script>
