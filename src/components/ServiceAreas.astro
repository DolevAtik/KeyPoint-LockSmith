---
import Icon from './Icon.astro';
import { areaRegions, allAreas, areaCount } from '../data/areas';
import { telHref, site } from '../data/site';

/** Payload for the map script — parsed from a JSON script tag, so the module
 *  stays bundle-friendly (no `define:vars`, which would force an inline script). */
const mapPayload = allAreas.map((a, i) => ({ i, city: a.city, zips: a.zips, lat: a.lat, lng: a.lng }));

// Index lookup so a list card can address its own marker.
let cursor = 0;
const regionsWithIndex = areaRegions.map((r) => ({
  ...r,
  cities: r.cities.map((c) => ({ ...c, index: cursor++ })),
}));
---

<section id="service-areas" class="section-y bg-paper text-on-paper" aria-labelledby="areas-heading">
  <div class="container-page">
    <!-- Intro -->
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow reveal text-gold-deep">Where KeyPoint works</p>
      <h2 id="areas-heading" class="reveal mt-3 text-[1.75rem] sm:mt-4 sm:text-4xl lg:text-[2.75rem]">
        <span class="sm:hidden">Across Ventura County &amp; LA</span>
        <span class="hidden sm:inline">Across Ventura County &amp; Los Angeles</span>
      </h2>
      <p class="reveal mt-3 text-[1.0625rem] text-on-paper-muted sm:mt-5">
        <span class="sm:hidden">Search your city or ZIP code to quickly confirm coverage.</span>
        <span class="hidden sm:inline">
          {site.name} covers Ventura, Oxnard, Camarillo, Simi Valley, Thousand Oaks and Westlake
          Village, plus the San Fernando Valley and greater Los Angeles — {areaCount} communities
          in total.
        </span>
      </p>
    </div>

    <!-- Coverage lookup is the primary mobile task; the full map and browseable
         region list remain available below for visitors who prefer them. -->
    <div class="reveal mx-auto mt-6 max-w-2xl rounded-2xl border border-paper-line bg-paper-card p-4 shadow-card sm:mt-9 sm:p-5">
      <form id="kp-area-search" role="search">
        <label for="kp-area-query" class="font-display text-sm font-bold text-on-paper">
          Check your service area
        </label>
        <div class="mt-2 flex flex-col gap-2 sm:flex-row">
          <input
            id="kp-area-query"
            type="search"
            inputmode="search"
            autocomplete="postal-code"
            list="kp-area-suggestions"
            placeholder="City or ZIP code"
            class="min-h-12 min-w-0 flex-1 rounded-xl border border-paper-line bg-paper px-4 text-base text-on-paper outline-none transition-[border-color,box-shadow,background-color] duration-200 placeholder:text-on-paper-muted/75 focus:border-gold focus:bg-paper-card focus:shadow-[0_0_0_4px_rgb(212_162_76_/_0.16)]"
          />
          <datalist id="kp-area-suggestions">
            {allAreas.map((area) => <option value={area.city}>{area.zips.join(' · ')}</option>)}
          </datalist>
          <button type="submit" class="btn btn-gold min-h-12 sm:px-6">
            Check coverage
          </button>
        </div>
      </form>

      <div
        id="kp-area-result"
        class="mt-3 rounded-xl border border-paper-line bg-paper px-4 py-3"
        role="status"
        aria-live="polite"
        hidden
      >
        <p class="font-display font-bold text-on-paper" data-area-result-title></p>
        <p class="mt-1 text-sm text-on-paper-muted" data-area-result-detail></p>
        <div class="mt-3 flex flex-wrap gap-2" data-area-result-actions hidden>
          <a href={telHref} class="btn btn-gold !min-h-11 !px-4 !text-sm" data-cta="area-search-call">
            <Icon name="phone" size={17} />
            Call for service
          </a>
          <button type="button" id="kp-area-show-map" class="btn btn-ghost-light !min-h-11 !px-4 !text-sm">
            <Icon name="map-pin" size={17} />
            Show on map
          </button>
        </div>
      </div>
    </div>

    <!-- ---------------------------------------------------------------- -->
    <!-- Map                                                               -->
    <!-- ---------------------------------------------------------------- -->
    <!-- Map stays open by default so coverage is visible immediately. -->
    <details id="kp-map-disclosure" class="reveal mt-6 sm:mt-10 lg:mt-14" open>
      <summary
        class="flex min-h-14 cursor-pointer list-none items-center gap-3 rounded-xl border border-paper-line bg-paper-card px-4 py-3 font-display font-bold shadow-card marker:content-none sm:hidden [&::-webkit-details-marker]:hidden"
      >
        <span class="grid h-9 w-9 place-items-center rounded-xl bg-ink text-gold">
          <Icon name="map-pin" size={18} />
        </span>
        Explore the service area map
        <Icon name="chevron-down" size={17} class="ml-auto text-gold-deep" />
      </summary>
      <div
        class="relative z-0 isolate mt-3 overflow-hidden rounded-2xl border border-paper-line bg-paper-card shadow-lift sm:mt-0"
      >
        <div
          id="kp-map"
          class="h-[220px] w-full md:h-[360px] lg:h-[480px]"
          role="application"
          aria-label={`Map of the ${areaCount} cities served by ${site.name}`}
        >
          <!-- Placeholder shown until Leaflet loads; also what a no-JS visitor
               sees, which is why the full area list below is the real content. -->
          <div id="kp-map-fallback" class="grid h-full w-full place-items-center bg-[#eef1f5] px-6 text-center">
            <div>
              <span class="mx-auto grid h-12 w-12 place-items-center rounded-full bg-ink text-gold">
                <Icon name="map-pin" size={24} />
              </span>
              <p class="mt-3 font-display text-sm font-semibold text-on-paper-muted">
                Loading service area map…
              </p>
              <p class="mt-1 text-xs text-on-paper-muted">
                All {areaCount} cities are listed below.
              </p>
            </div>
          </div>
        </div>

        <!-- Tap-to-interact shield: stops the map from stealing page scroll on
             touch devices until the visitor deliberately engages with it. -->
        <button
          type="button"
          id="kp-map-shield"
          class="absolute inset-0 z-[400] hidden place-items-center bg-ink/35 backdrop-blur-[1px]"
          aria-label="Activate the map"
        >
          <span
            class="rounded-full border border-white/20 bg-ink/85 px-5 py-3 font-display text-sm font-bold text-on-ink shadow-lift"
          >
            Tap to explore the map
          </span>
        </button>

        <div class="hidden items-center gap-2 border-t border-paper-line px-4 py-3 text-[0.8rem] text-on-paper-muted sm:flex">
          <Icon name="map-pin" size={15} class="text-gold-deep" />
          Select a marker or a city below to see its ZIP codes.
        </div>
      </div>
    </details>

    <!-- ---------------------------------------------------------------- -->
    <!-- Area list — the readable, crawlable source of truth               -->
    <!-- ---------------------------------------------------------------- -->
    {/* Regions stay folded until requested, keeping the full location list
        available without turning the section into a wall of city names. */}
    <div id="kp-regions" class="mt-8 space-y-4 sm:mt-12 sm:space-y-10 lg:mt-16 lg:space-y-12">
      {
        regionsWithIndex.map((region) => (
          <details class="kp-region reveal group">
            <summary class="flex min-h-12 cursor-pointer list-none flex-wrap items-center gap-x-4 gap-y-1 border-b border-paper-line py-2 marker:content-none sm:py-3 [&::-webkit-details-marker]:hidden">
              <h3 class="font-display text-lg font-bold text-on-paper sm:text-2xl">{region.region}</h3>
              <p class="hidden text-[0.9rem] text-on-paper-muted sm:block">{region.blurb}</p>
              <span class="ml-auto flex items-center gap-2 font-display text-[0.72rem] font-bold tracking-[0.14em] text-on-paper-muted uppercase sm:text-[0.75rem]">
                {region.cities.length} cities
                <Icon
                  name="chevron-down"
                  size={16}
                  class="text-gold-deep transition-transform duration-200 group-open:rotate-180"
                />
              </span>
            </summary>

            <ul class="mt-3 grid grid-cols-1 gap-2 min-[23rem]:grid-cols-2 sm:mt-5 sm:gap-3 lg:grid-cols-3 xl:grid-cols-4">
              {region.cities.map((city) => (
                <li>
                  <button
                    type="button"
                    class="area-card group flex min-h-12 w-full flex-col items-start justify-center rounded-xl border border-paper-line bg-paper-card px-3 py-2.5 text-left transition-[transform,border-color,box-shadow] duration-250 hover:border-gold hover:shadow-card sm:h-full sm:p-4 sm:hover:-translate-y-0.5"
                    data-city-index={city.index}
                  >
                    <span class="flex w-full items-center gap-1.5 sm:gap-2">
                      <Icon
                        name="map-pin"
                        size={15}
                        class="shrink-0 text-gold-deep transition-transform duration-250 group-hover:scale-110"
                      />
                      <span class="font-display text-[0.88rem] leading-tight font-bold text-on-paper sm:text-[0.98rem]">
                        {city.city}
                      </span>
                    </span>
                    {/* Clamped on a phone so a six-ZIP city cannot set the row
                        height for its whole line. The map popup lists them all. */}
                    <span class="mt-1 hidden text-[0.75rem] leading-relaxed text-on-paper-muted sm:mt-1.5 sm:block sm:text-[0.82rem]">
                      {city.zips.join(' · ')}
                    </span>
                  </button>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script type="application/json" id="kp-areas-data" set:html={JSON.stringify(mapPayload)} />

<script>
  const mapDisclosure = document.getElementById('kp-map-disclosure') as HTMLDetailsElement | null;
  if (mapDisclosure) {
    mapDisclosure.open = true;
    mapDisclosure.dataset.disclosureReady = '';
  }
</script>

<style is:global>
  @media (orientation: landscape) and (height <= 32rem) and (width < 64rem) {
    #kp-map {
      height: 15rem;
    }
  }

  .area-card.is-selected {
    border-color: var(--color-gold);
    background: #fffaf0;
    box-shadow: 0 0 0 3px rgb(212 162 76 / 0.16);
  }

  /* Leaflet chrome, restyled to match the site rather than the library default. */
  #kp-map .leaflet-container {
    font-family: var(--font-sans);
    background: #eef1f5;
  }

  /* Softens the raw OSM raster on desktop only — CSS filters on the tile
     pane force an extra full-size offscreen bitmap and are a known Safari
     memory spike when many tiles are visible. */
  @media (hover: hover) and (min-width: 64rem) {
    #kp-map .leaflet-tile-pane {
      filter: saturate(0.72) contrast(1.04) brightness(1.02);
    }
  }

  #kp-map .leaflet-popup-content-wrapper {
    border-radius: 0.85rem;
    padding: 0;
    background: var(--color-ink-card);
    color: var(--color-on-ink);
    box-shadow: 0 18px 40px -16px rgb(0 0 0 / 0.55);
    border: 1px solid var(--color-ink-line);
  }

  #kp-map .leaflet-popup-content {
    margin: 0;
    padding: 0.9rem 1.05rem;
    width: auto !important;
    line-height: 1.5;
  }

  #kp-map .leaflet-popup-tip {
    background: var(--color-ink-card);
    border: 1px solid var(--color-ink-line);
  }

  #kp-map .leaflet-popup-close-button {
    color: var(--color-on-ink-muted) !important;
    padding: 0.55rem 0.6rem 0 0 !important;
  }

  #kp-map .leaflet-popup-close-button:hover {
    color: var(--color-gold) !important;
  }

  #kp-map .kp-popup-city {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 700;
    color: var(--color-on-ink);
  }

  #kp-map .kp-popup-label {
    display: block;
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  #kp-map .kp-popup-zips {
    margin-top: 0.15rem;
    font-size: 0.85rem;
    color: var(--color-on-ink-muted);
  }

  #kp-map .kp-popup-call {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.7rem;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-gold);
    text-decoration: none;
  }

  #kp-map .kp-popup-call:hover {
    text-decoration: underline;
  }

  /* Custom pin: avoids Leaflet's default marker PNGs entirely. */
  #kp-map .kp-pin {
    display: block;
    transition:
      transform 0.2s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.2s ease;
    transform-origin: 50% 100%;
    filter: drop-shadow(0 4px 6px rgb(11 13 16 / 0.35));
  }

  #kp-map .leaflet-marker-icon:hover .kp-pin,
  #kp-map .kp-pin.is-active {
    transform: scale(1.22);
    filter: drop-shadow(0 7px 10px rgb(11 13 16 / 0.45));
  }

  #kp-map .leaflet-bar a {
    color: var(--color-on-paper);
  }

  #kp-map-shield.is-armed {
    display: grid;
  }
</style>

<script>
  // `?url` yields just the asset path. Importing the stylesheet normally would
  // make Astro hoist it into a render-blocking <link> in <head>, which defeats
  // the point of lazy-loading the map.
  import leafletCssUrl from 'leaflet/dist/leaflet.css?url';
  import { site, telHref } from '../data/site';

  interface Area {
    i: number;
    city: string;
    zips: string[];
    lat: number;
    lng: number;
  }

  const container = document.getElementById('kp-map');
  const dataEl = document.getElementById('kp-areas-data');

  const ensureMapOpen = () => {
    const disclosure = document.getElementById('kp-map-disclosure') as HTMLDetailsElement | null;
    if (disclosure) disclosure.open = true;
  };

  if (container && dataEl?.textContent) {
    const areas: Area[] = JSON.parse(dataEl.textContent);
    let ready: Promise<void> | null = null;
    let focusCity: ((index: number) => void) | null = null;
    let queued: number | null = null;
    let selectedAreaIndex: number | null = null;

    const searchForm = document.getElementById('kp-area-search') as HTMLFormElement | null;
    const searchInput = document.getElementById('kp-area-query') as HTMLInputElement | null;
    const searchResult = document.getElementById('kp-area-result');
    const resultTitle = searchResult?.querySelector<HTMLElement>('[data-area-result-title]');
    const resultDetail = searchResult?.querySelector<HTMLElement>('[data-area-result-detail]');
    const resultActions = searchResult?.querySelector<HTMLElement>('[data-area-result-actions]');
    const showMapButton = document.getElementById('kp-area-show-map') as HTMLButtonElement | null;

    const highlightArea = (index: number) => {
      document.querySelectorAll<HTMLElement>('.area-card.is-selected').forEach((card) => {
        card.classList.remove('is-selected');
      });

      const card = document.querySelector<HTMLElement>(`.area-card[data-city-index="${index}"]`);
      card?.classList.add('is-selected');
      const region = card?.closest<HTMLDetailsElement>('.kp-region');
      if (region) region.open = true;
    };

    const showSearchResult = (area: Area | null, query: string) => {
      if (!searchResult || !resultTitle || !resultDetail || !resultActions) return;
      searchResult.hidden = false;

      if (!area) {
        selectedAreaIndex = null;
        resultTitle.textContent = `We couldn't find “${query}” in the listed areas.`;
        resultDetail.textContent = 'Call with your location and we will confirm whether service is available.';
        resultActions.hidden = false;
        if (showMapButton) showMapButton.hidden = true;
        return;
      }

      selectedAreaIndex = area.i;
      resultTitle.textContent = `Yes — ${area.city} is in the service area.`;
      resultDetail.textContent = `Covered ZIP codes: ${area.zips.join(' · ')}`;
      resultActions.hidden = false;
      if (showMapButton) showMapButton.hidden = false;
      highlightArea(area.i);
    };

    searchForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      const rawQuery = searchInput?.value.trim() ?? '';
      if (!rawQuery) {
        searchInput?.focus();
        return;
      }

      const query = rawQuery.toLowerCase();
      const digits = rawQuery.replace(/\D/g, '');
      const exact = areas.find(
        (area) =>
          area.city.toLowerCase() === query ||
          (digits.length >= 5 && area.zips.some((zip) => zip === digits))
      );
      const partial =
        exact ??
        areas.find(
          (area) =>
            area.city.toLowerCase().includes(query) ||
            (digits.length >= 3 && area.zips.some((zip) => zip.startsWith(digits)))
        );

      showSearchResult(partial ?? null, rawQuery);
    });

    showMapButton?.addEventListener('click', () => {
      if (selectedAreaIndex === null) return;
      ensureMapOpen();
      requestAnimationFrame(() => {
        document
          .querySelector<HTMLButtonElement>(`.area-card[data-city-index="${selectedAreaIndex}"]`)
          ?.click();
      });
    });

    /**
     * Leaflet is ~150 KB — far too much to spend on a visitor who only wants a
     * phone number. It is fetched the first time the map is visible (disclosure
     * open + near viewport), or immediately if someone taps a city card / Show
     * on map before then.
     */
    const boot = () => {
      if (ready) return ready;

      /** Adds Leaflet's stylesheet on demand and resolves once it has applied. */
      const loadCss = () =>
        new Promise<void>((resolve) => {
          if (document.querySelector(`link[data-leaflet-css]`)) return resolve();
          const link = document.createElement('link');
          link.rel = 'stylesheet';
          link.href = leafletCssUrl;
          link.dataset.leafletCss = '';
          // Resolve either way — a missing stylesheet should not block the map.
          link.onload = () => resolve();
          link.onerror = () => resolve();
          document.head.appendChild(link);
        });

      ready = (async () => {
        const [L] = await Promise.all([import('leaflet').then((m) => m.default), loadCss()]);

        const fallback = document.getElementById('kp-map-fallback');
        fallback?.remove();

        const map = L.map(container, {
          scrollWheelZoom: false, // never hijack the page scroll
          zoomControl: true,
          attributionControl: false,
        });

        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 18,
        }).addTo(map);

        const pin = (active = false) =>
          L.divIcon({
            className: '',
            html: `<span class="kp-pin${active ? ' is-active' : ''}">
                     <svg width="30" height="38" viewBox="0 0 30 38" xmlns="http://www.w3.org/2000/svg">
                       <path d="M15 37S28 22.8 28 15A13 13 0 1 0 2 15c0 7.8 13 22 13 22Z" fill="#D4A24C" stroke="#0B0D10" stroke-width="1.6"/>
                       <circle cx="15" cy="14.6" r="5" fill="#0B0D10"/>
                     </svg>
                   </span>`,
            iconSize: [30, 38],
            iconAnchor: [15, 38],
            popupAnchor: [0, -32],
          });

        const markers = areas.map((area) => {
          const marker = L.marker([area.lat, area.lng], {
            icon: pin(),
            title: `${area.city}, CA`,
            alt: `${area.city} service area marker`,
            riseOnHover: true,
          }).addTo(map);

          marker.bindPopup(
            `<div>
               <p class="kp-popup-city">${area.city}, CA</p>
               <span class="kp-popup-label">ZIP codes</span>
               <p class="kp-popup-zips">${area.zips.join(' · ')}</p>
               <a class="kp-popup-call" href="${telHref}">Call Now &rarr;</a>
             </div>`,
            { closeButton: true, maxWidth: 260 }
          );

          return marker;
        });

        const bounds = L.latLngBounds(areas.map((a) => [a.lat, a.lng] as [number, number]));
        const fitAll = () => {
          map.fitBounds(bounds, { padding: [42, 42] });
          map.setZoom(map.getZoom() + 1);
        };
        fitAll();

        // Wheel zoom only after a deliberate click, disabled again on leaving.
        map.on('click', () => map.scrollWheelZoom.enable());
        map.on('mouseout', () => map.scrollWheelZoom.disable());

        // Touch devices: hold off panning until the visitor opts in, so a
        // swipe over the map scrolls the page as expected.
        const shield = document.getElementById('kp-map-shield');
        if (shield && window.matchMedia('(hover: none)').matches) {
          map.dragging.disable();
          shield.classList.add('is-armed');
          shield.addEventListener(
            'click',
            () => {
              map.dragging.enable();
              shield.classList.remove('is-armed');
            },
            { once: true }
          );
        }

        focusCity = (index: number) => {
          const marker = markers[index];
          const area = areas[index];
          if (!marker || !area) return;

          map.dragging.enable();
          document.getElementById('kp-map-shield')?.classList.remove('is-armed');
          // Re-measure after the disclosure opens / was display:none.
          map.invalidateSize();
          map.flyTo([area.lat, area.lng], 12, { duration: 0.7 });
          marker.openPopup();
        };

        if (queued !== null) {
          focusCity(queued);
          queued = null;
        }

        // Leaflet mis-sizes itself if the container was laid out while hidden.
        requestAnimationFrame(() => map.invalidateSize());
      })();

      return ready;
    };

    const disclosure = document.getElementById('kp-map-disclosure') as HTMLDetailsElement | null;
    let observed = false;

    const watchAndBoot = () => {
      if (observed || ready) return;
      if (disclosure && !disclosure.open) return;

      observed = true;
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              io.disconnect();
              boot();
            }
          },
          { rootMargin: '120px' }
        );
        io.observe(container);
      } else {
        boot();
      }
    };

    watchAndBoot();
    disclosure?.addEventListener('toggle', () => {
      if (disclosure.open) watchAndBoot();
    });

    // City cards drive the map — open the disclosure first on phones/tablets.
    document.querySelectorAll<HTMLButtonElement>('.area-card').forEach((card) => {
      card.addEventListener('click', () => {
        const index = Number(card.dataset.cityIndex);
        if (Number.isNaN(index)) return;

        ensureMapOpen();
        container.scrollIntoView({ behavior: 'smooth', block: 'center' });

        requestAnimationFrame(() => {
          if (focusCity) {
            focusCity(index);
          } else {
            queued = index;
            boot();
          }
        });
      });
    });
  }
</script>
