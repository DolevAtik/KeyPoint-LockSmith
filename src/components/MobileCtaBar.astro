---
import Icon from './Icon.astro';
import { telHref, whatsappHref, WA_DEFAULT_MESSAGE } from '../data/site';

const wa = whatsappHref(WA_DEFAULT_MESSAGE);
---

<div
  id="kp-mobile-cta"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-ink-line bg-ink lg:hidden"
  role="group"
  aria-label="Call or WhatsApp"
  hidden
>
  <div class="flex gap-2.5 px-3 pt-2.5 pb-[max(0.625rem,env(safe-area-inset-bottom))]">
    <a
      href={telHref}
      class="btn btn-gold min-w-0 flex-1 !min-h-12 !px-3 !text-[0.95rem]"
      data-cta="mobile-bar-call"
    >
      <Icon name="phone" size={18} />
      Call Now
    </a>
    <a
      href={wa}
      target="_blank"
      rel="noopener"
      class="btn btn-ghost-dark min-w-0 flex-1 !min-h-12 !px-3 !text-[0.95rem]"
      data-cta="mobile-bar-whatsapp"
      aria-label="Message on WhatsApp"
    >
      <Icon name="whatsapp" size={18} class="text-whatsapp" />
      WhatsApp
    </a>
  </div>
</div>

<style>
  #kp-mobile-cta {
    transform: translateY(110%);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.28s var(--ease-out-soft, ease),
      opacity 0.22s ease;
  }

  #kp-mobile-cta.is-visible {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    #kp-mobile-cta {
      transition: none;
    }
  }
</style>

<script>
  const bar = document.getElementById('kp-mobile-cta');
  const hero = document.getElementById('home');
  const contact = document.getElementById('contact');

  if (bar && hero && window.matchMedia('(max-width: 63.99rem)').matches) {
    bar.hidden = false;

    let pastHero = false;
    let inContact = false;

    const sync = () => {
      bar.classList.toggle('is-visible', pastHero && !inContact);
    };

    if ('IntersectionObserver' in window) {
      // Visible only between hero and contact — avoids doubling CTAs in either section.
      new IntersectionObserver(
        ([entry]) => {
          pastHero = !entry.isIntersecting;
          sync();
        },
        { threshold: 0 }
      ).observe(hero);

      if (contact) {
        new IntersectionObserver(
          ([entry]) => {
            inContact = entry.isIntersecting;
            sync();
          },
          { threshold: 0, rootMargin: '0px 0px -12% 0px' }
        ).observe(contact);
      }
    } else {
      const onScroll = () => {
        const y = window.scrollY;
        pastHero = y > hero.offsetHeight - 48;
        inContact = contact
          ? contact.getBoundingClientRect().top < window.innerHeight * 0.88
          : false;
        sync();
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  }
</script>
