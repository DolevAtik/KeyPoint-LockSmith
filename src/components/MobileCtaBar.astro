---
import Icon from './Icon.astro';
import { site, telHref, whatsappHref, WA_EMERGENCY_MESSAGE } from '../data/site';

const wa = whatsappHref(WA_EMERGENCY_MESSAGE);
---

{/* Marks the point past which the hero's own CTAs are off screen. */}
<div id="kp-cta-sentinel" aria-hidden="true" class="pointer-events-none h-px w-full"></div>

<div
  id="kp-mobile-cta"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-ink-line bg-ink/95 backdrop-blur-lg lg:hidden"
>
  <div class="flex gap-2 px-2.5 pt-2.5 pb-[max(0.625rem,env(safe-area-inset-bottom))] sm:gap-2.5 sm:px-3">
    <a
      href={telHref}
      class="btn btn-gold !min-h-[3.25rem] min-w-0 flex-1 !gap-1.5 !px-2.5 !text-[0.9rem] sm:!gap-2 sm:!px-4 sm:!text-[1rem]"
      data-cta="sticky-call"
    >
      <Icon name="phone" size={19} />
      Call Now
    </a>
    <a
      href={wa}
      target="_blank"
      rel="noopener"
      class="btn btn-whatsapp !min-h-[3.25rem] min-w-0 flex-1 !gap-1.5 !px-2.5 !text-[0.9rem] sm:!gap-2 sm:!px-4 sm:!text-[1rem]"
      data-cta="sticky-whatsapp"
    >
      <Icon name="whatsapp" size={19} />
      WhatsApp
    </a>
  </div>

  <span class="sr-only">Emergency locksmith contact: {site.phoneDisplay}</span>
</div>

<style>
  #kp-mobile-cta {
    /* Starts tucked away so it does not sit on top of the hero's own buttons. */
    transform: translateY(110%);
    transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow: 0 -12px 30px -18px rgb(0 0 0 / 0.9);
  }

  #kp-mobile-cta.is-visible {
    transform: translateY(0);
  }

  /* Without JS the bar is simply always available. */
  html:not(.js) #kp-mobile-cta {
    transform: translateY(0);
  }

  @media (orientation: landscape) and (max-height: 32rem) and (max-width: 63.99rem) {
    #kp-mobile-cta {
      display: none;
    }
  }
</style>

<script>
  const bar = document.getElementById('kp-mobile-cta');
  const sentinel = document.getElementById('kp-cta-sentinel');

  if (bar && sentinel) {
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => {
          // Reveal once the hero — and its Call/WhatsApp buttons — has scrolled by.
          const passed = !entry.isIntersecting && entry.boundingClientRect.top < 0;
          bar.classList.toggle('is-visible', passed);
        },
        { threshold: 0 }
      ).observe(sentinel);
    } else {
      bar.classList.add('is-visible');
    }
  }
</script>
